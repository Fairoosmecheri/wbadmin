# Use a unique password and generate AUTH_SECRET: openssl rand -hex 32
POSTGRES_USER=wbadmin
POSTGRES_PASSWORD=replace-with-a-unique-local-password
POSTGRES_DB=wbadmin
DATABASE_URL=postgresql://wbadmin:replace-with-a-unique-local-password@127.0.0.1:5432/wbadmin
AUTH_SECRET=replace-with-at-least-32-random-characters
APP_URL=http://localhost:3000
DEFAULT_PHONE_COUNTRY=IN
APP_TIMEZONE=Asia/Kolkata
WHATSAPP_MODE=mock
# Required only in cloud mode; choose a currently supported Meta version.
META_GRAPH_API_VERSION=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_SEND_BATCH_SIZE=25
WHATSAPP_SEND_RATE_LIMIT=5
WHATSAPP_TEST_NUMBERS=
WHATSAPP_OPT_OUT_KEYWORDS=STOP,UNSUBSCRIBE
WHATSAPP_REPLY_ATTRIBUTION_DAYS=7
WHATSAPP_TEMPLATE_SYNC_MAX_AGE_HOURS=24
# Seed runs only outside production. Change this before any public deployment.
SEED_ADMIN_PASSWORD=
